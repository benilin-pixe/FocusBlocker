{
  "manifest_version": 3,
  "name": "FocusBlocker",
  "version": "1.0.0",
  "description": "Blocks YouTube Shorts and TikTok.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://focusblocker.netlify.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://www.tiktok.com/*",
        "https://tiktok.com/*"
      ],
      "js": [
        "blocker.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "FocusBlocker"
  }
}