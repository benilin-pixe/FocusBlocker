{
  "manifest_version": 3,
  "name": "FocusBlocker",
  "version": "1.0.0",
  "description": "Blocks distracting websites such as YouTube Shorts and TikTok.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FocusBlocker",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocker.html",
        "blocker.css",
        "blocker.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}